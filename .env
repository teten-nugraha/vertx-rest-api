# Server Config
SERVER_PORT=8080

# PostgreSQL Database Config
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=
DB_NAME=belajar-vertx-db

# HikariCP Connection Pooling Config
# Jumlah maksimal koneksi aktif dan idle dalam pool
DB_POOL_MAX_SIZE=10

# Jumlah minimum koneksi idle yang selalu dijaga dalam pool
DB_POOL_MIN_IDLE=2

# Waktu tunggu maksimal untuk mendapatkan koneksi sebelum timeout (milidetik)
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# Waktu maksimal sebuah koneksi boleh idle sebelum dipensiunkan (milidetik)
DB_POOL_IDLE_TIMEOUT_MS=600000

# Masa hidup maksimal sebuah koneksi sebelum diganti koneksi baru (milidetik)
DB_POOL_MAX_LIFETIME_MS=1800000

# Interval periodik untuk memastikan koneksi tetap hidup (milidetik)
DB_POOL_KEEPALIVE_TIME_MS=300000

# Waktu deteksi kebocoran koneksi (0 = nonaktif, > 0 = milidetik)
DB_POOL_LEAK_DETECTION_THRESHOLD_MS=0
